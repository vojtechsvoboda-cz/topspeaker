{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "topspeaker",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "KONFIGURACE", "id": "fa52100e41be4552b375f24cf744d6ab" }
  ]
}
